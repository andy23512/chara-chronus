---
import "../styles/global.css";

interface Props {
	/** The `/og` page is a render target for the social preview image, not content. */
	readonly noindex?: boolean;
	readonly showRibbon?: boolean;
}

const { noindex = false, showRibbon = true } = Astro.props;

const title = "CharaChronus - An unofficial chronicle of CharaChorder";
const description =
	"An unofficial chronicle of CharaChorder: the milestones, products, and events of the company and its community, from its founding in 2019 onward.";
const repository = "https://github.com/andy23512/chara-chronus";

// BASE_URL has no trailing slash when `base` is configured without one, so
// normalise before concatenating paths onto it.
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const pathname = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site);
const ogImage = new URL(`${base}image/og.png`, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="bl8dOZwnp1uBHRnIzTpUAndXGt1aQQb1p5fcvBqA_Ao" />
		<link rel="icon" href={`${base}favicon.ico`} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CharaChronus" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="CharaChronus - Every Character, Every Chord, Every Milestone" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body class="dark" style={`--clock-background-image: url("${base}image/clock.png")`}>
		<slot />
		{showRibbon && <a class="github-ribbon" href={repository} target="_blank" rel="noopener noreferrer" title="Fork me on GitHub"><span>Fork me on GitHub</span></a>}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
	}
</style>
